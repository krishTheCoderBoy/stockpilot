ENVIRONMENT=development
# Same value as every other service: the chatbot verifies the user's JWT locally.
SECRET_KEY=change-me-to-the-same-secret-as-auth-inventory-and-procurement
ALGORITHM=HS256
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Every tool calls business APIs through the gateway with the user's own token.
GATEWAY_URL=http://localhost:8000

# Model provider. Never commit a real key. With no key at all, /chat returns a friendly
# "assistant not configured" reply instead of failing.
#
# LLM_PROVIDER=auto uses ANTHROPIC_API_KEY if set, otherwise GROK_API_KEY. A Groq key
# (gsk_...) is sent only to api.groq.com and an xAI key (xai-...) only to api.x.ai.
LLM_PROVIDER=auto
GROK_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: Groq openai/gpt-oss-120b, xAI grok-4, Anthropic CHATBOT_MODEL.
LLM_MODEL=
# Claude only:
CHATBOT_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
CHATBOT_EFFORT=medium
# gpt-oss models on Groq: low | medium | high
LLM_REASONING_EFFORT=low

# Signs confirmation tokens for mutating actions. Optional in development (derived from
# SECRET_KEY); set a separate random value in production.
CHAT_ACTION_SECRET=
