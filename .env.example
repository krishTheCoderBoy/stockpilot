# Used by docker-compose.yml. Copy to .env and change the secrets; every value has a
# development default, so compose also works without this file.

# JWT signing key. All three services must receive the same value.
SECRET_KEY=change-me-dev-only-shared-secret

# Shared secret for service-to-service calls (inventory -> auth recipients lookup).
INTERNAL_SERVICE_TOKEN=change-me-dev-only-internal-token

POSTGRES_USER=stockpilot_user
POSTGRES_PASSWORD=stockpilot_pass

# Host ports, in case the defaults clash with something already running locally.
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Outgoing email (OTP codes, notifications). Leave empty to run without email: OTP and
# notification jobs will fail to send but the rest of the system works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@stockpilot.com
